{"version":3,"term":{"cols":175,"rows":40},"timestamp":1785231962,"command":"bash assets/asciinema/hubble-audit-policy-correlation/record-hubble-correlation.sh","env":{"SHELL":"/bin/zsh"}}
[10.514, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\u001b[90m# Cilium 1.20: Hubble correlates a policy verdict back to the policy responsible for it.\u001b[0m\r\n"]
[1.714, "o", "\u001b[90m# The deathstar endpoints are in Policy Audit Mode, so a deny is LOGGED but NOT enforced.\u001b[0m\r\n"]
[1.107, "o", "\u001b[1;32m$\u001b[0m "]
[0.000, "o", "c"]
[0.034, "o", "a"]
[0.033, "o", "t"]
[0.038, "o", " "]
[0.035, "o", "m"]
[0.036, "o", "a"]
[0.033, "o", "n"]
[0.037, "o", "i"]
[0.035, "o", "f"]
[0.037, "o", "e"]
[0.037, "o", "s"]
[0.036, "o", "t"]
[0.034, "o", "s"]
[0.034, "o", "/"]
[0.034, "o", "c"]
[0.037, "o", "n"]
[0.036, "o", "p"]
[0.037, "o", "."]
[0.033, "o", "y"]
[0.036, "o", "a"]
[0.034, "o", "m"]
[0.033, "o", "l"]
[0.034, "o", "\r\n"]
[0.312, "o", "# The policies the audit demo records. Three of them, so Hubble has one policy to\r\n# name in each direction and for each outcome:\r\n#\r\n#   rule1         ingress allow -> INGRESS ALLOWED BY rule1         (ingress_allowed_by)\r\n#   deny-alliance ingress deny  -> INGRESS AUDITED BY deny-alliance (ingress_denied_by)\r\n#   xwing-egress  egress allow  -> EGRESS ALLOWED BY xwing-egress   (egress_allowed_by)\r\n#\r\n# Allow empire ships to reach the deathstar on TCP 80...\r\napiVersion: \"cilium.io/v2\"\r\nkind: CiliumNetworkPolicy\r\nmetadata:\r\n  name: \"rule1\"\r\nspec:\r\n  description: \"Allow empire ships to reach the deathstar on TCP 80\"\r\n  endpointSelector:\r\n    matchLabels:\r\n      org: empire\r\n      class: deathstar\r\n  ingress:\r\n    - fromEndpoints:\r\n        - matchLabels:\r\n            org: empire\r\n      toPorts:\r\n        - ports:\r\n            - port: \"80\"\r\n              protocol: TCP\r\n---\r\n# ...and EXPLICITLY deny alliance ships. Hubble correlates the verdict back to\r\n# this deny policy because a deny entry was matched. That alre"]
[0.000, "o", "ady worked for\r\n# enforced denies; what 1.20 adds is the same naming for AUDIT verdicts, which is\r\n# what this demo records.\r\napiVersion: \"cilium.io/v2\"\r\nkind: CiliumNetworkPolicy\r\nmetadata:\r\n  name: \"deny-alliance\"\r\nspec:\r\n  description: \"Explicitly deny alliance ships to the deathstar\"\r\n  endpointSelector:\r\n    matchLabels:\r\n      class: deathstar\r\n  ingressDeny:\r\n    - fromEndpoints:\r\n        - matchLabels:\r\n            org: alliance\r\n---\r\n# Egress side of the story, on the xwing itself. Selecting the xwing for egress\r\n# makes it egress-restricted, so the same flow is evaluated and correlated in BOTH\r\n# directions: EGRESS ALLOWED BY xwing-egress on the way out, INGRESS AUDITED BY\r\n# deny-alliance on the way in.\r\n#\r\n# The DNS rule is required, not decoration: the demo curls the deathstar by\r\n# Service FQDN, so once egress is restricted the xwing must still reach kube-dns\r\n# or the name never resolves and no flow ever arrives at the deathstar.\r\napiVersion: \"cilium.io/v2\"\r\nkind: CiliumNetworkPolicy\r\nmetadata:"]
[0.000, "o", "\r\n  name: \"xwing-egress\"\r\nspec:\r\n  description: \"Allow the xwing to reach the deathstar on TCP 80, plus cluster DNS\"\r\n  endpointSelector:\r\n    matchLabels:\r\n      org: alliance\r\n      class: xwing\r\n  egress:\r\n    - toEndpoints:\r\n        - matchLabels:\r\n            class: deathstar\r\n      toPorts:\r\n        - ports:\r\n            - port: \"80\"\r\n              protocol: TCP\r\n    - toEndpoints:\r\n        - matchLabels:\r\n            io.kubernetes.pod.namespace: kube-system\r\n            k8s-app: kube-dns\r\n      toPorts:\r\n        - ports:\r\n            - port: \"53\"\r\n              protocol: UDP\r\n"]
[3.004, "o", "\r\n\u001b[90m# Apply all three: ingress allow (rule1), ingress deny (deny-alliance), egress allow (xwing-egress).\u001b[0m\r\n"]
[1.105, "o", "\u001b[1;32m$\u001b[0m k"]
