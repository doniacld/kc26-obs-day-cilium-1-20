{
  "uid": "ztunnel-mtls",
  "title": "Cilium ztunnel / native mTLS",
  "tags": [
    "cilium",
    "ztunnel",
    "mtls"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "Workloads protected by mTLS (mtls-demo ns)",
      "description": "Live count of pods in the mTLS-enrolled namespace (io.cilium/mtls-enabled=true). Sourced from kube-state-metrics: count(kube_pod_info) scoped to that namespace.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calc": "lastNotNull",
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "P1809F7CD0C75ACF3"
          },
          "editorMode": "code",
          "expr": "count(kube_pod_info{exported_namespace=\"mtls-demo\"})",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes running ztunnel proxy",
      "description": "Nodes whose ztunnel proxy holds an active ZDS connection to the Cilium agent. Gauge: sum(cilium_ztunnel_zds_connection_active), one per node.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calc": "lastNotNull",
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "P1809F7CD0C75ACF3"
          },
          "editorMode": "code",
          "expr": "sum(cilium_ztunnel_zds_connection_active)",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Enrollment events since start (cumulative)",
      "description": "Lifetime counter of ztunnel enrollment events across all nodes, not the current number of enrolled endpoints. It only increases and climbs with pod restarts and churn: sum(cilium_ztunnel_zds_enrollment_total).",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calc": "lastNotNull",
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "P1809F7CD0C75ACF3"
          },
          "editorMode": "code",
          "expr": "sum(cilium_ztunnel_zds_enrollment_total)",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Enrollment failures",
      "description": "Total ztunnel enrollment failures across all nodes. Should stay at 0 on a healthy cluster: sum(cilium_ztunnel_zds_enrollment_failures_total).",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calc": "lastNotNull",
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "P1809F7CD0C75ACF3"
          },
          "editorMode": "code",
          "expr": "sum(cilium_ztunnel_zds_enrollment_failures_total) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Enrollment events per node (cumulative counter)",
      "description": "Per-node value of cilium_ztunnel_zds_enrollment_total. This is a monotonic counter of enrollment events over the node's lifetime, so the flat/step-up shape is expected. It is not the current count of enrolled endpoints.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "P1809F7CD0C75ACF3"
          },
          "editorMode": "code",
          "expr": "cilium_ztunnel_zds_enrollment_total",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "ztunnel proxy connection state per node (1 = connected)",
      "description": "Per-node value of cilium_ztunnel_zds_connection_active. 1 means the node's ztunnel proxy is connected to the Cilium agent over ZDS; 0 means disconnected.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
